Function {make_TSdialog()} {open
} {
  Fl_Window {} {
    label {Kachina Test Suite} open
    xywh {654 141 500 300} type Double
    code0 {\#include "support.h"} visible
  } {
    Fl_Menu_Bar {} {open
      xywh {0 0 500 20}
    } {
      Submenu {} {
        label {&Files} open
        xywh {0 0 62 20}
      } {
        MenuItem mnuOpen {
          label {&Open}
          callback {openFile();}
          xywh {0 0 30 20}
        }
        MenuItem mnuSave {
          label {&Save}
          callback {saveFile();}
          xywh {0 0 30 20}
        }
        MenuItem mnuSaveAs {
          label {Save &As}
          callback {saveFileAs();}
          xywh {0 0 30 20} divider
        }
        MenuItem mnuExit {
          label {E&xit}
          callback {exit(0);}
          xywh {0 0 30 20}
        }
      }
      MenuItem mnuEvents {
        label {&Events}
        callback {debug::show();}
        xywh {0 0 36 21}
        code0 {\#include "debug.h"}
      }
      MenuItem mnuAbout {
        label {&About}
        callback {about();}
        xywh {0 0 34 21}
      }
    }
    Fl_Tabs {} {open
      xywh {0 22 500 295}
    } {
      Fl_Group {} {
